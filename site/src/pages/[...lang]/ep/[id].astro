---
import Layout from '../../../layouts/Layout.astro';
import { getAllEpisodes } from '../../../lib/episodes';
import type { ProcessedEpisode } from '../../../lib/episodes';
import { withUtm } from '../../../lib/jpnotes';
import { CHANNEL_PARAMS, langOf, channelOf, chp, altPaths, RSS_PATH, SHOW_NAME } from '../../../lib/i18n';

const allEpisodes = getAllEpisodes(channelOf(Astro.params.lang));

export async function getStaticPaths() {
  // Every episode in both languages: /ep/NNN/ and /zh/ep/NNN/, and for the
  // all-Japanese show /nihongo/ep/NNN/ and /zh/nihongo/ep/NNN/.
  return CHANNEL_PARAMS.flatMap(({ lang, channel }) => getAllEpisodes(channel).map(ep => ({
    params: { lang, id: ep.paddedNum },
    props: { episode: ep },
  })));
}

interface Props { episode: ProcessedEpisode; }
const { episode } = Astro.props;
const lang = langOf(Astro.params.lang);
const channel = channelOf(Astro.params.lang);
const isNihongo = channel === 'nihongo';
const showName = SHOW_NAME[channel];
const clp = (p: string) => chp(p, lang, channel);
const epNo = Number(episode.paddedNum);
const pageDescription = lang === 'zh' ? episode.descriptionZh : episode.description;
// Titles in the reader's language and the words learners search for
// ("日语新闻听力", "easy Japanese news"); the Japanese headline stays the H1.
const translatedTitle = lang === 'zh' ? episode.titleZh : episode.titleEn;
// Translation shown under each Japanese sentence, in the page's language.
const trLines = lang === 'zh' ? episode.zhLines : episode.enLines;
const pageTitle = isNihongo
  ? `${(lang === 'zh' ? episode.titleZh : episode.titleEn) || episode.title} | ${showName} ${epNo}`
  : lang === 'zh'
  ? `${episode.titleZh || episode.title}｜日语新闻听力 第${epNo}集`
  : `${episode.titleEn || episode.title} | Easy Japanese News EP ${episode.paddedNum}`;

const sorted = [...allEpisodes].sort((a, b) => a.episode - b.episode);
const epIdx = sorted.findIndex(e => e.episode === episode.episode);
const prevEp = epIdx > 0 ? sorted[epIdx - 1] : null;
const nextEp = epIdx < sorted.length - 1 ? sorted[epIdx + 1] : null;

const SITE = 'https://podcast.jpnotes.dev';
const lastSeg = episode.timedSegments[episode.timedSegments.length - 1];
const durationISO = `PT${Math.round((lastSeg?.end || 0) + 2)}S`;

const episodeJsonLd = {
  "@context": "https://schema.org",
  "@type": "PodcastEpisode",
  "name": `EP ${episode.paddedNum}: ${episode.title}`,
  "alternateName": [episode.titleEn, episode.titleZh].filter(Boolean),
  "inLanguage": "ja",
  "episodeNumber": epNo,
  "description": pageDescription,
  "url": `${SITE}${clp(`/ep/${episode.paddedNum}/`)}`,
  "datePublished": episode.date,
  "duration": durationISO,
  "associatedMedia": {
    "@type": "MediaObject",
    "contentUrl": `${SITE}/audio/${episode.id}.mp3`
  },
  "partOfSeries": {
    "@type": "PodcastSeries",
    "name": showName,
    "url": isNihongo ? `${SITE}/nihongo/` : SITE
  }
};

function formatDate(d: string) {
  if (lang === 'zh') {
    const [y, m, day] = d.split('-').map(Number);
    return `${y}年${m}月${day}日`;
  }
  return new Date(d + 'T00:00:00').toLocaleDateString('en-US', {
    month: 'short', day: 'numeric', year: 'numeric',
  });
}

function speakerLabel(s: string) {
  if (lang === 'zh') {
    return ({ host: '主持', guide: '讲解', news: '新闻', slow: '慢速', vocab: '词汇' } as Record<string, string>)[s] || s;
  }
  switch (s) {
    case 'host': return 'Host';
    case 'guide': return 'Guide';
    case 'news': return 'News';
    case 'slow': return 'Slow Repeat';
    case 'vocab': return 'Vocab';
    default: return s;
  }
}

const segs = episode.timedSegments;
const firstSlowIdx = segs.findIndex(s => s.speaker === 'slow');
// "Japanese only" mode: the first full reading of the news, before the breakdown.
const pureIdx = new Set(segs.map((_, i) => i).filter(i =>
  !isNihongo && segs[i].speaker === 'news' && (firstSlowIdx < 0 || i < firstSlowIdx)));
const vocabRecapIdx = segs.findIndex(s =>
  s.speaker === 'host' &&
  (s.text.toLowerCase().includes('vocabulary recap') ||
   s.text.toLowerCase().includes("today's vocabulary"))
);

const segmentsForClient = segs.map(s => ({
  i: s.index, s: s.start, e: s.end, sp: s.speaker, t: s.text,
  r: s.ruby || '',
}));
---
<Layout rss={{ title: showName, href: RSS_PATH[channel] }}
  lang={lang}
  fullTitle={pageTitle}
  description={pageDescription}
  jsonLd={episodeJsonLd}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": lang === 'zh' ? "首页" : "Home", "item": `${SITE}${clp('/')}` },
      { "@type": "ListItem", "position": 2, "name": episode.title, "item": `${SITE}${clp(`/ep/${episode.paddedNum}/`)}` }
    ]
  })} />
  <nav class="nav">
    <a href={clp('/')} class="nav-logo">{showName}</a>
    <div class="nav-links">
      <a href={RSS_PATH[channel]} class="nav-link nav-rss-icon">
        <svg viewBox="0 0 24 24"><path d="M6.18 15.64a2.18 2.18 0 010 4.36 2.18 2.18 0 010-4.36zM4 4.44A15.56 15.56 0 0119.56 20h-2.83A12.73 12.73 0 004 7.27V4.44zm0 5.66a9.9 9.9 0 019.9 9.9h-2.83A7.07 7.07 0 004 12.93V10.1z"/></svg>
        RSS
      </a>
      <div class="fontsize-toggle" id="fontsize-toggle">
        <button class="fontsize-btn" data-size="small" title="Small">A</button>
        <button class="fontsize-btn active" data-size="medium" title="Medium">A</button>
        <button class="fontsize-btn" data-size="large" style="font-size:0.9375rem" title="Large">A</button>
      </div>
      <div class="lang-toggle" id="lang-toggle">
        <a class="lang-btn" data-lang="en" hreflang="en" href={altPaths(Astro.url.pathname).en}>EN</a>
        <a class="lang-btn" data-lang="zh" hreflang="zh-Hans" href={altPaths(Astro.url.pathname).zh}>中</a>
      </div>
      <button class="theme-btn" id="theme-toggle" aria-label="Toggle theme">
        <svg class="icon-moon" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
        <svg class="icon-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" stroke="currentColor" stroke-width="2" fill="none"/></svg>
      </button>
    </div>
  </nav>

  <header class="ep-header">
    <div class="ep-topbar">
      <a href={clp('/')} class="ep-back">&larr; {lang === 'zh' ? '全部节目' : 'Episodes'}</a>
      <div class="ep-topnav">
        {prevEp && (
          <a href={clp(`/ep/${prevEp.paddedNum}/`)} class="ep-topnav-link ep-nav-prev" title={`EP ${prevEp.paddedNum}: ${prevEp.title}`}>
            &larr; <span class="i18n-en">Prev</span><span class="i18n-zh">上一集</span>
          </a>
        )}
        {nextEp && (
          <a href={clp(`/ep/${nextEp.paddedNum}/`)} class="ep-topnav-link ep-nav-next" title={`EP ${nextEp.paddedNum}: ${nextEp.title}`}>
            <span class="i18n-en">Next</span><span class="i18n-zh">下一集</span> &rarr;
          </a>
        )}
      </div>
    </div>
    <p class="ep-page-meta">
      {lang === 'zh' ? `第 ${Number(episode.paddedNum)} 集` : `Episode ${episode.paddedNum}`} &middot; {formatDate(episode.date)} &middot; {episode.source}
    </p>
    <h1 class="ep-page-title" lang="ja">{episode.title}</h1>
    {translatedTitle && <p class="ep-page-subtitle">{translatedTitle}</p>}
  </header>

  <main class="episode-body">
    <div class="mode-bar">
      <div class="mode-toggle">
        <button class="mode-btn active" data-mode="fulltext"><span class="i18n-en">Full Text</span><span class="i18n-zh">全文</span></button>
        {!isNihongo && <button class="mode-btn" data-mode="japanese"><span class="i18n-en">Japanese only</span><span class="i18n-zh">纯日语</span></button>}
        {!isNihongo && <button class="mode-btn" data-mode="practice"><span class="i18n-en">Practice</span><span class="i18n-zh">精听</span></button>}
      </div>
      {Object.keys(trLines).length > 2 && (
        <button class="tr-toggle" id="tr-toggle" type="button"
          title={lang === 'zh' ? '显示/隐藏每句下面的中文翻译' : 'Show/hide the English translation under each sentence'}>
          <span class="tr-toggle-dot"></span>{lang === 'zh' ? '译文' : 'Translation'}
        </button>
      )}
    </div>

    <!-- Transcript -->
    <div class="transcript" id="transcript">
      {segs.map((seg, i) => (
        <>
          {i === firstSlowIdx && firstSlowIdx > 0 && (
            <div class="transcript-divider"><span><span class="i18n-en">Breakdown</span><span class="i18n-zh">逐句讲解</span></span></div>
          )}
          {i === vocabRecapIdx && vocabRecapIdx > 0 && (
            <div class="transcript-divider"><span><span class="i18n-en">Vocabulary Recap</span><span class="i18n-zh">词汇回顾</span></span></div>
          )}
          <div
            class={`segment segment-${seg.speaker}${pureIdx.has(i) ? ' seg-pure' : ''}`}
            data-index={seg.index}
            data-start={seg.start}
            data-end={seg.end}
          >
            <div class="segment-label">
              <span class="segment-dot"></span>
              {speakerLabel(seg.speaker)}
            </div>
            {seg.ruby
              ? <div class="segment-text" set:html={seg.ruby} />
              : <div class="segment-text">{seg.text}</div>
            }
            {seg.speaker !== 'host' && trLines[seg.text.trim()] &&
              <div class="segment-tr" lang={lang === 'zh' ? 'zh-CN' : 'en'}>{trLines[seg.text.trim()]}</div>}
          </div>
        </>
      ))}
    </div>

    {/* Apply the saved Japanese-only mode before the first paint (the main
        script below runs later; without this the page showed the full text
        and then jumped). The main script still does the rest on load. */}
    <script is:inline define:vars={{ noJaMode: isNihongo }}>
      (function(){
        if (noJaMode) return;
        var ja = /[?&]mode=ja/.test(location.search);
        try { ja = ja || localStorage.getItem('jdn-mode') === 'japanese'; } catch(e) {}
        if (!ja) return;
        document.getElementById('transcript').classList.add('ja-only');
        document.querySelectorAll('.mode-btn').forEach(function(b) {
          b.classList.toggle('active', b.getAttribute('data-mode') === 'japanese');
        });
      })();
    </script>

    <!-- Practice mode -->
    <div class="practice-view" id="practice-view">
      <div class="practice-card">
        <div class="practice-progress">
          <span id="prac-cur">1</span> / <span id="prac-total">0</span>
        </div>
        <div class="practice-sentence" id="prac-text"></div>
        <button class="practice-toggle" id="prac-toggle"><span class="i18n-en">Show explanation</span><span class="i18n-zh">显示解释</span> &darr;</button>
        <div class="practice-explanation" id="prac-explanation"></div>
        <div class="practice-nav">
          <button class="practice-nav-btn" id="prac-prev">&larr; <span class="i18n-en">Prev</span><span class="i18n-zh">上一句</span></button>
          <button class="practice-nav-btn replay" id="prac-replay">&#8635; <span class="i18n-en">Replay</span><span class="i18n-zh">重播</span></button>
          <button class="practice-nav-btn" id="prac-next"><span class="i18n-en">Next</span><span class="i18n-zh">下一句</span> &rarr;</button>
        </div>
      </div>

      {episode.grammar.length > 0 && (
        <div class="practice-grammar">
          <h3 class="practice-grammar-title"><span class="i18n-en">Grammar Reference</span><span class="i18n-zh">语法参考</span></h3>
          <div class="grammar-list">
            {episode.grammar.map(g => (
              <div class="grammar-card">
                <div class="grammar-header">
                  <span class="grammar-pattern">{g.pattern}</span>
                  {g.level && <span class="grammar-level">{g.level}</span>}
                </div>
                {lang === 'zh' && g.meaningZh
                  ? <div class="grammar-meaning-zh">{g.meaningZh}</div>
                  : <div class="grammar-meaning">{g.meaning}</div>}
                <div class="grammar-formation">{g.formation}</div>
                <div class="grammar-example" set:html={g.example} />
                <div class="grammar-translation">{g.translation}</div>
                {lang === 'zh' && g.noteZh
                  ? <div class="grammar-note-zh">{g.noteZh}</div>
                  : g.note && <div class="grammar-note">{g.note}</div>}
                {g.jpnotes && <a class="grammar-card-link" href={withUtm(g.jpnotes.url, 'web')} target="_blank" rel="noopener">{g.jpnotes.matched ? <><span class="i18n-en">Grammar notes &rarr;</span><span class="i18n-zh">语法详解 &rarr;</span></> : <><span class="i18n-en">{g.level} grammar list &rarr;</span><span class="i18n-zh">{g.level} 语法清单 &rarr;</span></>}</a>}
              </div>
            ))}
          </div>
        </div>
      )}
    </div>

    <!-- Vocab & Grammar review -->
    {(episode.vocabulary.length > 0 || episode.grammar.length > 0) && (
      <section class="review-section" id="review-section">
        <button class="review-toggle" id="review-toggle">
          <span class="i18n-en">Vocabulary &amp; Grammar</span><span class="i18n-zh">词汇与语法</span> <span class="review-arrow">&darr;</span>
        </button>
        <div class="review-content" id="review-content" style="display:none">
        {episode.vocabulary.length > 0 && (
          <>
            <h2 class="review-heading"><span class="i18n-en">Vocabulary</span><span class="i18n-zh">词汇</span></h2>
            <div class="vocab-grid">
              {episode.vocabulary.map(v => (
                <div class="vocab-card">
                  <div class="vocab-ja">{v.ja}</div>
                  <div class="vocab-reading">{v.reading}</div>
                  {lang === 'zh' && v.zh
                    ? <div class="vocab-zh">{v.zh}</div>
                    : <div class="vocab-en">{v.en}</div>}
                </div>
              ))}
            </div>
          </>
        )}
        {episode.grammar.length > 0 && (
          <>
            <h2 class="review-heading"><span class="i18n-en">Grammar</span><span class="i18n-zh">语法</span></h2>
            <div class="grammar-list">
              {episode.grammar.map(g => (
                <div class="grammar-card">
                  <div class="grammar-header">
                    <span class="grammar-pattern">{g.pattern}</span>
                    {g.level && <span class="grammar-level">{g.level}</span>}
                  </div>
                  {lang === 'zh' && g.meaningZh
                    ? <div class="grammar-meaning-zh">{g.meaningZh}</div>
                    : <div class="grammar-meaning">{g.meaning}</div>}
                  <div class="grammar-formation">{g.formation}</div>
                  <div class="grammar-example" set:html={g.example} />
                  <div class="grammar-translation">{g.translation}</div>
                  {lang === 'zh' && g.noteZh
                    ? <div class="grammar-note-zh">{g.noteZh}</div>
                    : g.note && <div class="grammar-note">{g.note}</div>}
                  {g.jpnotes && <a class="grammar-card-link" href={withUtm(g.jpnotes.url, 'web')} target="_blank" rel="noopener">{g.jpnotes.matched ? <><span class="i18n-en">Grammar notes &rarr;</span><span class="i18n-zh">语法详解 &rarr;</span></> : <><span class="i18n-en">{g.level} grammar list &rarr;</span><span class="i18n-zh">{g.level} 语法清单 &rarr;</span></>}</a>}
                </div>
              ))}
            </div>
            <a href={withUtm('https://jpnotes.dev/', 'web')} class="grammar-jpnotes" target="_blank" rel="noopener">
              <span class="i18n-en">More grammar at jpnotes.dev &rarr;</span>
              <span class="i18n-zh">更多语法请访问 jpnotes.dev &rarr;</span>
            </a>
          </>
        )}
        </div>
      </section>
    )}

    <script is:inline>
      (function(){
        var c = document.getElementById('review-content'), b = document.getElementById('review-toggle');
        try { if (c && b && localStorage.getItem('jdn-review-open') === '1') { c.style.display = ''; b.classList.add('open'); } } catch(e) {}
      })();
    </script>

    <!-- Prev / Next -->
    <nav class="ep-nav">
      {prevEp ? (
        <a href={clp(`/ep/${prevEp.paddedNum}/`)} class="ep-nav-link ep-nav-prev">
          <span class="ep-nav-label">&larr; <span class="i18n-en">Previous</span><span class="i18n-zh">上一集</span></span>
          <span class="ep-nav-title">EP {prevEp.paddedNum}: {prevEp.title}</span>
        </a>
      ) : <span />}
      {nextEp ? (
        <a href={clp(`/ep/${nextEp.paddedNum}/`)} class="ep-nav-link ep-nav-next">
          <span class="ep-nav-label"><span class="i18n-en">Next</span><span class="i18n-zh">下一集</span> &rarr;</span>
          <span class="ep-nav-title">EP {nextEp.paddedNum}: {nextEp.title}</span>
        </a>
      ) : <span />}
    </nav>
  </main>

  <!-- Vocab tooltip -->
  <div id="vocab-tooltip" class="vocab-tooltip" style="display:none">
    <div class="tt-ja" id="tt-ja"></div>
    <div class="tt-reading" id="tt-reading"></div>
    <div class="tt-en" id="tt-en"></div>
  </div>

  <!-- Player -->
  <div class="player-bar" id="player">
    <audio id="audio" preload="auto">
      <source src={`/audio/${episode.id}.mp3`} type="audio/mpeg" />
    </audio>
    <div class="player-inner">
      <div class="player-progress" id="progressBar">
        <div class="player-progress-fill" id="progressFill"></div>
      </div>
      <div class="player-controls">
        <button class="play-btn" id="playBtn" aria-label="Play">
          <svg id="iconPlay" viewBox="0 0 24 24"><polygon points="8,5 19,12 8,19"/></svg>
          <svg id="iconPause" viewBox="0 0 24 24" style="display:none"><rect x="6" y="5" width="4" height="14"/><rect x="14" y="5" width="4" height="14"/></svg>
        </button>
        <div class="player-time">
          <span class="player-time-current" id="currentTime">0:00</span>
          <span> / </span>
          <span id="totalTime">0:00</span>
        </div>
        <div class="speed-controls" id="speedControls">
          <button class="speed-btn" data-speed="0.5">0.5&times;</button>
          <button class="speed-btn" data-speed="0.75">0.75&times;</button>
          <button class="speed-btn active" data-speed="1">1&times;</button>
          <button class="speed-btn" data-speed="1.25">1.25&times;</button>
          <button class="speed-btn" data-speed="1.5">1.5&times;</button>
          <button class="speed-btn" data-speed="2">2&times;</button>
        </div>
        <button class="speed-btn autoplay-btn" id="autoplayBtn" title="Auto-play next episode / 自动连播下一集">
          <span class="i18n-en">Auto &rsaquo;</span><span class="i18n-zh">连播 &rsaquo;</span>
        </button>
        <button class="speed-btn playlist-btn" id="playlistBtn" type="button" aria-controls="playlist" aria-expanded="false"
          title={lang === 'zh' ? '播放列表' : 'Episode list'}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h13M3 12h13M3 18h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none"/><path d="M19 14v6l4-3z" fill="currentColor"/></svg>
          <span class="i18n-en">List</span><span class="i18n-zh">列表</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Playlist panel (filled from /episodes.json when opened) -->
  <div class="playlist" id="playlist" role="dialog" aria-label={lang === 'zh' ? '播放列表' : 'Episode list'} hidden>
    <div class="pl-head">
      <strong class="pl-title"><span class="i18n-en">Episodes</span><span class="i18n-zh">播放列表</span></strong>
      <button class="pl-close" id="plClose" type="button" aria-label="Close">&times;</button>
    </div>
    <div class="pl-controls">
      <div class="pl-seg" id="plOrder" role="group">
        <button type="button" data-order="asc"><span class="i18n-en">Oldest first</span><span class="i18n-zh">从旧到新</span></button>
        <button type="button" data-order="desc"><span class="i18n-en">Newest first</span><span class="i18n-zh">从新到旧</span></button>
      </div>
      <div class="pl-seg" id="plLevel" role="group" hidden={isNihongo}>
        <button type="button" data-level="all"><span class="i18n-en">All</span><span class="i18n-zh">全部</span></button>
        <button type="button" data-level="N5-N4">N5–N4</button>
        <button type="button" data-level="N4-N3">N4–N3</button>
      </div>
    </div>
    <p class="pl-note"><span class="i18n-en">{isNihongo ? 'Auto-play follows this order.' : 'Auto-play follows this order and level.'}</span><span class="i18n-zh">{isNihongo ? '连播按这里的顺序播放。' : '连播按这里的顺序和级别播放。'}</span></p>
    <ol class="pl-list" id="plList"></ol>
  </div>

  <div id="seg-data" data-show={showName} data-channel-path={isNihongo ? '/nihongo' : ''} data-prev={prevEp ? prevEp.paddedNum : ''} data-v={JSON.stringify(segmentsForClient)} data-ep={episode.id} data-cv={episode.contentVersion || ''} data-next={nextEp ? nextEp.paddedNum : ''} data-pzh={JSON.stringify(episode.practiceZh)} data-num={episode.paddedNum} data-title={episode.title} data-level={episode.level} style="display:none"></div>

  <script is:inline>
  // Shared by every episode played on this page load (see swapIn).
  var epList = null, epListP = null;
  // addEventListener's { signal } option (Safari 15+). Without it old listeners
  // can't be dropped, so episodes are changed by navigating.
  var canSwap = (function() {
    var ok = false;
    try {
      window.addEventListener('jdn-probe', null, { get signal() { ok = true; return undefined; } });
    } catch(e) {}
    return ok;
  })();
  // The URL moved with pushState and the page is one episode at a time.
  window.addEventListener('popstate', function() { location.reload(); });

  function initEpisode(arrive) {
    var ctrl = new AbortController();
    var sig = { signal: ctrl.signal };   // listeners on what outlives an episode: audio, document, window
    var dataEl = document.getElementById('seg-data');
    var raw = JSON.parse(dataEl.getAttribute('data-v'));
    var epId = dataEl.getAttribute('data-ep');
    var epCv = dataEl.getAttribute('data-cv') || '';
    var nextEpNum = dataEl.getAttribute('data-next') || '';
    var langPrefix = document.documentElement.getAttribute('data-force-lang') === 'zh' ? '/zh' : '';
    var channelPath = document.getElementById('seg-data').getAttribute('data-channel-path') || '';
    var isNihongo = !!channelPath;
    var pagePrefix = langPrefix + channelPath;
    var practiceZhArr = JSON.parse(dataEl.getAttribute('data-pzh') || '[]');
    var segments = raw.map(function(r) {
      return { index: r.i, start: r.s, end: r.e, speaker: r.sp, text: r.t, ruby: r.r };
    });

    var audio = document.getElementById('audio');
    var playBtn = document.getElementById('playBtn');
    var iconPlay = document.getElementById('iconPlay');
    var iconPause = document.getElementById('iconPause');
    var progressBar = document.getElementById('progressBar');
    var progressFill = document.getElementById('progressFill');
    var currentTimeEl = document.getElementById('currentTime');
    var totalTimeEl = document.getElementById('totalTime');
    var speedControls = document.getElementById('speedControls');
    var segmentEls = document.querySelectorAll('.segment[data-index]');
    var tooltip = document.getElementById('vocab-tooltip');

    var activeIndex = -1;
    var isDragging = false;
    var practiceMode = false;

    // ===== Japanese-only range (first full reading of the news) =====
    var jaOnly = false;
    var restoringMode = false;   // true while re-applying the saved mode on load (no GA)
    var pureSegs = segments.filter(function(s, i) {
      return segmentEls[i] && segmentEls[i].classList.contains('seg-pure');
    });
    var rStart = pureSegs.length ? pureSegs[0].start : 0;
    var rEnd = pureSegs.length ? pureSegs[pureSegs.length - 1].end : 0;
    function rangeOn() { return jaOnly && rEnd > rStart; }

    // ===== Lock screen / notification: the current sentence as the title =====
    var msArtist = dataEl.getAttribute('data-show') + ' · EP ' + (dataEl.getAttribute('data-num') || '');
    var msAlbum = dataEl.getAttribute('data-title') || '';
    var msArt = [{ src: '/cover.jpg', sizes: '3000x3000', type: 'image/jpeg' }];
    var msLast = null;
    function setNowPlaying(title) {
      if (!('mediaSession' in navigator) || typeof MediaMetadata === 'undefined') return;
      if (title === msLast) return;
      msLast = title;
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: title, artist: msArtist, album: msAlbum, artwork: msArt
        });
      } catch(e) {}
    }
    setNowPlaying(msAlbum);

    // Lock screens show about two lines of the title and cut the rest, and a
    // page can't change that. So a long sentence goes out in pieces, each one
    // shown while it is being read (its share of the sentence, by length).
    var LOCK_MAX = 24;   // full-width characters; ASCII counts as half
    function cols(t) {
      var n = 0;
      for (var i = 0; i < t.length; i++) n += t.charCodeAt(i) < 128 ? 0.5 : 1;
      return n;
    }
    // A clause with no punctuation in reach: break at a space or after a
    // particle that starts a new word, else at the limit.
    function breakClause(part) {
      var out = [];
      while (cols(part) > LOCK_MAX) {
        var i = 0, c = 0, cut = 0;
        for (; i < part.length; i++) {
          c += part.charCodeAt(i) < 128 ? 0.5 : 1;
          if (c > LOCK_MAX) break;
          if (/\s/.test(part[i]) || (/[はがをにでとも]/.test(part[i]) && /[^ぁ-ん]/.test(part[i + 1] || ''))) cut = i + 1;
        }
        if (cut < i / 2) cut = i;
        out.push(part.slice(0, cut));
        part = part.slice(cut);
      }
      out.push(part);
      return out;
    }
    function lockPieces(text) {
      var pieces = [], cur = '';
      (text.match(/.+?(?:[、。！？,.!?;:]+[」』）"']*\s*|$)/g) || [text]).forEach(function(clause) {
        breakClause(clause).forEach(function(part) {
          if (cur && cols(cur + part) > LOCK_MAX) { pieces.push(cur.trim()); cur = ''; }
          cur += part;
        });
      });
      if (cur.trim()) pieces.push(cur.trim());
      return pieces;
    }
    function lockLine(seg, t) {
      var pieces = seg.lock || (seg.lock = lockPieces(seg.text.trim()));
      var left = (t - seg.start) / (seg.end - seg.start) * cols(seg.text);
      for (var i = 0; i < pieces.length - 1; i++) {
        left -= cols(pieces[i]);
        if (left < 0) return pieces[i];
      }
      return pieces[pieces.length - 1];
    }
    function viewDur() { return rangeOn() ? rEnd - rStart : audio.duration; }
    function viewPos() { return rangeOn() ? Math.max(0, pos() - rStart) : pos(); }
    var autoPauseAt = -1;
    var storageKey = 'jdn-' + epId;

    // ===== Seeking =====
    // iOS Safari fetches only the metadata until the first play(), and a seek
    // issued then, with no play() in the same tap, never finishes: `seeking`
    // stays true, no timeupdate, no sound, even after play(). Japanese only and
    // resuming a saved position both hung on it. So until there is media data
    // the position waits in pendingSeek and is applied once play() has fetched
    // some. Always move and read the position through these two.
    var pendingSeek = null;
    function seek(t) {
      if (audio.readyState >= 2) { pendingSeek = null; audio.currentTime = t; }
      else pendingSeek = t;
    }
    function pos() { return pendingSeek !== null ? pendingSeek : audio.currentTime; }
    function applySeek() {
      if (pendingSeek === null || audio.readyState < 2) return;
      var t = pendingSeek;
      pendingSeek = null;
      audio.currentTime = t;
    }
    audio.addEventListener('loadeddata', applySeek, sig);
    audio.addEventListener('canplay', applySeek, sig);
    var progressKey = 'jdn-progress';

    // ===== GA4 analytics state =====
    var gaPlayed = false;
    var gaCompleted = false;
    var gaMilestones = { 25: false, 50: false, 75: false };
    var gaSeekTimer = null;
    var epLevel = dataEl.getAttribute('data-level') || '';
    function ga(name, params) {
      if (!window.jdnEvent) return;
      params = params || {};
      params.episode_id = epId;
      if (epLevel) params.level = epLevel;   // N5-N4 (morning) / N4-N3 (evening)
      window.jdnEvent(name, params);
    }

    // ===== Listening analytics =====
    // Sections of the fixed episode structure, so drop-off can be read per part
    // (audio_section: breakdown / replay / quiz / end) instead of by percent.
    var sectionStarts = (function() {
      var out = [], firstSlow = -1, quiz = -1;
      for (var i = 0; i < segments.length; i++) {
        var sp = segments[i].speaker;
        if (firstSlow < 0 && sp === 'slow') firstSlow = i;
        if (quiz < 0 && sp === 'host' && /quiz/i.test(segments[i].text)) quiz = i;
      }
      if (firstSlow >= 0) {
        out.push({ name: 'breakdown', t: segments[firstSlow].start });
        for (var j = firstSlow; j < segments.length; j++) {
          if (segments[j].speaker === 'news') { out.push({ name: 'replay', t: segments[j].start }); break; }
        }
      }
      if (quiz >= 0) out.push({ name: 'quiz', t: segments[quiz].start });
      if (segments.length) out.push({ name: 'end', t: segments[segments.length - 1].start });
      return out;
    })();
    var sectionSeen = {};
    var lastT = null;          // last timeupdate position, to tell playing from seeking
    var listenSec = 0;         // seconds actually played since the last report
    var bgSent = false;
    function trackListening() {
      var t = audio.currentTime;
      if (lastT !== null && !audio.paused) {
        var d = t - lastT;
        if (d > 0 && d < 2) {   // continuous playback, not a seek
          listenSec += d / (audio.playbackRate || 1);   // wall-clock seconds
          if (!jaOnly) {
            for (var k = 0; k < sectionStarts.length; k++) {
              var sec = sectionStarts[k];
              if (!sectionSeen[sec.name] && lastT < sec.t && t >= sec.t) {
                sectionSeen[sec.name] = true;
                ga('audio_section', { section: sec.name });
              }
            }
          }
          if (document.hidden && !bgSent) { bgSent = true; ga('background_listen'); }
        }
      }
      lastT = t;
    }
    function reportListenTime() {
      if (listenSec >= 1) {
        ga('audio_listen_time', { seconds: Math.round(listenSec), mode: jaOnly ? 'japanese' : (practiceMode ? 'practice' : 'fulltext') });
        listenSec = 0;
      }
    }
    document.addEventListener('visibilitychange', function() {
      if (document.hidden && !audio.paused && !bgSent) { bgSent = true; ga('background_listen'); }
      if (document.hidden) reportListenTime();
    }, sig);
    window.addEventListener('pagehide', reportListenTime, sig);

    function getProgress() {
      try { return JSON.parse(localStorage.getItem(progressKey)) || {}; } catch(e) { return {}; }
    }

    function saveProgress(field, value) {
      var p = getProgress();
      if (!p[epId]) p[epId] = {};
      p[epId][field] = value;
      localStorage.setItem(progressKey, JSON.stringify(p));
    }

    // ===== localStorage: restore =====
    try {
      var saved = JSON.parse(localStorage.getItem(storageKey));
      // Per-episode cache invalidation: if THIS episode has a contentVersion and
      // it differs from what was saved, the saved playback position is stale
      // (timing shifted) — drop it. Other episodes are untouched.
      if (saved && epCv && saved.ver !== epCv) {
        localStorage.removeItem(storageKey);
        saved = null;
      }
      if (saved) {
        if (saved.time > 1) {
          seek(saved.time);
          currentTimeEl.textContent = fmt(saved.time);
        }
      }
      // Speed is the listener's preference, not per episode: the last speed
      // chosen anywhere (jdn-speed) wins, so auto-play keeps it on the next
      // episode. Older per-episode saves are the fallback.
      var prefSpeed = parseFloat(localStorage.getItem('jdn-speed') || '') || (saved && saved.speed) || 1;
      if (prefSpeed !== 1) {
        audio.defaultPlaybackRate = prefSpeed;   // Safari resets playbackRate to this on load
        audio.playbackRate = prefSpeed;
        var btns = speedControls.querySelectorAll('.speed-btn');
        for (var k = 0; k < btns.length; k++) {
          btns[k].classList.toggle('active', parseFloat(btns[k].getAttribute('data-speed')) === prefSpeed);
        }
      }
    } catch(e) {}

    // ===== Autoplay next episode =====
    var autoplayKey = 'jdn-autoplay';
    var autoplayBtn = document.getElementById('autoplayBtn');
    var autoplayOn = false;
    try { autoplayOn = localStorage.getItem(autoplayKey) === '1'; } catch(e) {}
    autoplayBtn.classList.toggle('active', autoplayOn);
    autoplayBtn.addEventListener('click', function() {
      autoplayOn = !autoplayOn;
      autoplayBtn.classList.toggle('active', autoplayOn);
      try { localStorage.setItem(autoplayKey, autoplayOn ? '1' : '0'); } catch(e) {}
      ga('autoplay_toggle', { on: autoplayOn ? 1 : 0 });
    });
    // Arriving from a finished episode: start playing (browsers may block; then
    // the user just taps play — the button state is already correct)
    // (the play itself is deferred to the end of setup, after the mode is set)
    var arrivedAutoplay = arrive.autoplay || /[?&]autoplay=1/.test(location.search);
    var arrivedJaOnly = arrive.ja || /[?&]mode=ja/.test(location.search);
    var arrivedPlay = arrive.play || /[?&]play=1/.test(location.search);   // picked from the playlist while playing
    if (arrivedAutoplay || arrivedJaOnly || arrivedPlay) {
      try { history.replaceState(null, '', location.pathname); } catch(e) {}
    }

    // ===== Practice data =====
    var practicePairs = [];
    var pzhIdx = 0;
    var inQuiz = false;
    for (var i = 0; i < segments.length; i++) {
      if (segments[i].speaker === 'host' && segments[i].text.toLowerCase().indexOf('quiz') >= 0) {
        inQuiz = true;
      }
      if (segments[i].speaker === 'host' && segments[i].text.toLowerCase().indexOf('recap') >= 0) {
        inQuiz = false;
      }
      if (segments[i].speaker === 'slow' && !inQuiz) {
        var explanations = [];
        for (var j = i + 1; j < segments.length && segments[j].speaker === 'host'; j++) {
          explanations.push(segments[j].text);
        }
        practicePairs.push({
          segIndex: i, start: segments[i].start, end: segments[i].end,
          text: segments[i].text, ruby: segments[i].ruby,
          explanation: explanations.join(' '),
          explanationZh: practiceZhArr[pzhIdx] || ''
        });
        pzhIdx++;
      }
    }
    var practiceIdx = 0;

    var pracView = document.getElementById('practice-view');
    var pracText = document.getElementById('prac-text');
    var pracCur = document.getElementById('prac-cur');
    var pracTotal = document.getElementById('prac-total');
    var pracExplanation = document.getElementById('prac-explanation');
    var pracToggle = document.getElementById('prac-toggle');
    var pracPrev = document.getElementById('prac-prev');
    var pracNext = document.getElementById('prac-next');
    var pracReplay = document.getElementById('prac-replay');
    var transcript = document.getElementById('transcript');
    var reviewSection = document.getElementById('review-section');

    pracTotal.textContent = practicePairs.length;

    function fmt(sec) {
      if (!sec || isNaN(sec)) return '0:00';
      var m = Math.floor(sec / 60);
      var s = Math.floor(sec % 60);
      return m + ':' + (s < 10 ? '0' : '') + s;
    }

    function tryPlay() {
      var p = audio.play();
      if (p && p.catch) p.catch(function() {});
    }

    // ===== Play / Pause =====
    playBtn.addEventListener('click', function() {
      if (audio.paused) {
        if (rangeOn() && (pos() < rStart || pos() >= rEnd)) seek(rStart);
        tryPlay();
      } else audio.pause();
    });

    audio.addEventListener('play', function() {
      iconPlay.style.display = 'none';
      iconPause.style.display = 'block';
      if (!gaPlayed) { gaPlayed = true; ga('audio_play'); }
    }, sig);

    audio.addEventListener('pause', function() {
      iconPlay.style.display = 'block';
      iconPause.style.display = 'none';
    }, sig);

    audio.addEventListener('ended', function() {
      if (!gaCompleted) { gaCompleted = true; ga('audio_complete'); }
      saveFinished();
      var nextFull = nextEpisode();
      if (autoplayOn && nextFull) {
        ga('autoplay_next');
        goToEpisode(nextFull, { autoplay: true });
      }
    }, sig);

    // Finished: reset saved position so a revisit starts from the top (keep speed)
    function saveFinished() {
      try { localStorage.setItem(storageKey, JSON.stringify({ time: 0, speed: audio.playbackRate, ver: epCv })); } catch(e) {}
    }

    audio.addEventListener('loadedmetadata', function() {
      totalTimeEl.textContent = fmt(viewDur());
      if (pos() > audio.duration) seek(0);
      // The range is only known now: a saved position was shown as file time.
      currentTimeEl.textContent = fmt(viewPos());
      progressFill.style.width = (viewDur() ? viewPos() / viewDur() * 100 : 0) + '%';
    }, sig);
    if (audio.readyState >= 1) {
      totalTimeEl.textContent = fmt(audio.duration);
      if (pos() > audio.duration) seek(0);
    }

    // ===== Time update =====
    var saveCounter = 0;
    audio.addEventListener('timeupdate', function() {
      if (leaving) return;
      if (rangeOn()) {
        if (pos() < rStart - 0.05) seek(rStart);
        else if (pos() >= rEnd) {
          ga('japanese_only_complete');
          // Auto-play on: carry on with the next episode, still Japanese only
          var nextJa = nextEpisode();
          if (autoplayOn && nextJa) {
            saveFinished();
            ga('autoplay_next', { mode: 'japanese' });
            goToEpisode(nextJa, { autoplay: true, ja: true });
            return;
          }
          audio.pause();
          seek(rStart);
        }
      }
      if (autoplayOn && !prepared && (rangeOn() ? rEnd : audio.duration) - pos() < 30) prepareNext();
      if (!isDragging) {
        var vd = viewDur();
        var pct = vd ? (viewPos() / vd) * 100 : 0;
        progressFill.style.width = pct + '%';
        currentTimeEl.textContent = fmt(viewPos());
      }

      // Auto-pause in practice mode
      if (autoPauseAt > 0 && audio.currentTime >= autoPauseAt - 0.08) {
        audio.pause();
        autoPauseAt = -1;
      }

      if (!practiceMode) updateActiveSegment();
      trackListening();

      // Mark as listened when past 80%
      if (audio.duration && audio.currentTime / audio.duration > 0.8) {
        saveProgress('listened', true);
      }

      // GA4 progress milestones (only count forward progress, not seeking)
      if (audio.duration && !isDragging) {
        var pctNow = (audio.currentTime / audio.duration) * 100;
        [25, 50, 75].forEach(function(m) {
          if (!gaMilestones[m] && pctNow >= m && pctNow < m + 5) {
            gaMilestones[m] = true;
            ga('audio_progress', { progress: m });
          }
        });
      }

      // localStorage: save every ~2s
      if (++saveCounter % 8 === 0) {
        try {
          localStorage.setItem(storageKey, JSON.stringify({
            time: pos(),
            speed: audio.playbackRate,
            ver: epCv
          }));
        } catch(e) {}
      }
    }, sig);

    // ===== Seek =====
    function seekTo(clientX) {
      var rect = progressBar.getBoundingClientRect();
      var pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      if (audio.duration) {
        seek(rangeOn() ? rStart + pct * (rEnd - rStart) : pct * audio.duration);
        progressFill.style.width = (pct * 100) + '%';
        currentTimeEl.textContent = fmt(viewPos());
      }
    }
    function gaSeekDebounced() {
      if (gaSeekTimer) clearTimeout(gaSeekTimer);
      gaSeekTimer = setTimeout(function() {
        if (audio.duration) {
          ga('audio_seek', { position: Math.round((audio.currentTime / audio.duration) * 100) });
        }
      }, 600);
    }
    progressBar.addEventListener('mousedown', function(e) { isDragging = true; seekTo(e.clientX); });
    document.addEventListener('mousemove', function(e) { if (isDragging) seekTo(e.clientX); }, sig);
    document.addEventListener('mouseup', function() { if (isDragging) { isDragging = false; gaSeekDebounced(); } }, sig);
    progressBar.addEventListener('touchstart', function(e) { isDragging = true; seekTo(e.touches[0].clientX); }, { passive: true });
    document.addEventListener('touchmove', function(e) { if (isDragging) seekTo(e.touches[0].clientX); }, sig);
    document.addEventListener('touchend', function() { if (isDragging) { isDragging = false; gaSeekDebounced(); } }, sig);

    // ===== Speed =====
    speedControls.addEventListener('click', function(e) {
      var btn = e.target.closest('.speed-btn');
      if (!btn) return;
      var speed = parseFloat(btn.getAttribute('data-speed'));
      audio.defaultPlaybackRate = speed;
      audio.playbackRate = speed;
      var btns = speedControls.querySelectorAll('.speed-btn');
      for (var k = 0; k < btns.length; k++) btns[k].classList.remove('active');
      btn.classList.add('active');
      try {
        localStorage.setItem(storageKey, JSON.stringify({ time: pos(), speed: speed, ver: epCv }));
        localStorage.setItem('jdn-speed', String(speed));
      } catch(e) {}
      ga('audio_speed_change', { speed: speed });
    });

    // ===== Transcript sync =====
    function updateActiveSegment() {
      var t = audio.currentTime;
      var newActive = -1;
      for (var k = 0; k < segments.length; k++) {
        if (t >= segments[k].start && t < segments[k].end) { newActive = k; break; }
      }
      if (newActive >= 0) setNowPlaying(lockLine(segments[newActive], t));
      if (newActive !== activeIndex) {
        for (var k = 0; k < segmentEls.length; k++) segmentEls[k].classList.remove('active');
        if (newActive >= 0 && segmentEls[newActive]) {
          segmentEls[newActive].classList.add('active');
          try {
            segmentEls[newActive].scrollIntoView({ behavior: 'smooth', block: 'center' });
          } catch(e) {
            segmentEls[newActive].scrollIntoView(true);
          }
        }
        activeIndex = newActive;
      }
    }

    for (var k = 0; k < segmentEls.length; k++) {
      (function(idx) {
        segmentEls[idx].addEventListener('click', function(e) {
          if (e.target.closest('.vw')) return;
          seek(segments[idx].start);
          tryPlay();
        });
      })(k);
    }

    // ===== Vocab tooltip =====
    document.addEventListener('click', function(e) {
      var vw = e.target.closest('.vw');
      if (vw) {
        e.stopPropagation();
        var ja = vw.getAttribute('data-ja');
        var reading = vw.getAttribute('data-reading');
        var en = vw.getAttribute('data-en');
        document.getElementById('tt-ja').textContent = ja;
        document.getElementById('tt-reading').textContent = reading;
        document.getElementById('tt-en').textContent = en;
        var rect = vw.getBoundingClientRect();
        tooltip.style.top = (rect.bottom + window.scrollY + 8) + 'px';
        tooltip.style.left = (rect.left + rect.width / 2) + 'px';
        tooltip.style.display = '';
        ga('vocab_click', { word: ja });
      } else {
        tooltip.style.display = 'none';
      }
    }, sig);

    // ===== Mode toggle =====
    var modeBtns = document.querySelectorAll('.mode-btn');
    for (var k = 0; k < modeBtns.length; k++) {
      modeBtns[k].addEventListener('click', function() {
        for (var j = 0; j < modeBtns.length; j++) modeBtns[j].classList.remove('active');
        this.classList.add('active');
        var mode = this.getAttribute('data-mode');
        // Full text / Japanese only is a listening preference, kept for every
        // episode (like speed). Practice is a task on this one episode, so it
        // doesn't overwrite the preference.
        if (mode !== 'practice') { try { localStorage.setItem('jdn-mode', mode); } catch(e) {} }
        setJaOnly(mode === 'japanese');
        if (mode === 'practice') {
          practiceMode = true;
          transcript.style.display = 'none';
          if (reviewSection) reviewSection.style.display = 'none';
          pracView.classList.add('visible');
          showPractice(practiceIdx);
          if (!restoringMode) ga('practice_mode_on');
        } else {
          practiceMode = false;
          autoPauseAt = -1;
          transcript.style.display = '';
          if (reviewSection) reviewSection.style.display = '';
          pracView.classList.remove('visible');
        }
      });
    }

    function setJaOnly(on) {
      if (on === jaOnly) return;
      jaOnly = on;
      transcript.classList.toggle('ja-only', on);
      if (rangeOn() && (pos() < rStart || pos() >= rEnd)) seek(rStart);
      if (on && !restoringMode) ga('japanese_only_on');
      if (audio.duration) {
        totalTimeEl.textContent = fmt(viewDur());
        currentTimeEl.textContent = fmt(viewPos());
        progressFill.style.width = (viewDur() ? viewPos() / viewDur() * 100 : 0) + '%';
      }
    }

    // ===== Practice mode =====
    function showPractice(idx) {
      if (idx < 0 || idx >= practicePairs.length) return;
      practiceIdx = idx;
      var pair = practicePairs[idx];
      if (pair.ruby) {
        pracText.innerHTML = pair.ruby;
      } else {
        pracText.textContent = pair.text;
      }
      pracCur.textContent = idx + 1;
      setNowPlaying(pair.text);
      var lang = document.documentElement.getAttribute('data-lang') || 'en';
      pracExplanation.textContent = (lang === 'zh' && pair.explanationZh) ? pair.explanationZh : pair.explanation;
      pracExplanation.classList.remove('open');
      pracToggle.innerHTML = '<span class="i18n-en">Show explanation</span><span class="i18n-zh">显示解释</span> &darr;';
      pracPrev.disabled = idx === 0;
      pracNext.disabled = idx === practicePairs.length - 1;
      if (idx === practicePairs.length - 1) saveProgress('practiced', true);

    }

    function playPractice(idx) {
      if (idx < 0 || idx >= practicePairs.length) return;
      showPractice(idx);
      seek(practicePairs[idx].start);
      autoPauseAt = practicePairs[idx].end;
      tryPlay();
    }

    pracReplay.addEventListener('click', function() { playPractice(practiceIdx); });
    pracText.addEventListener('click', function() { playPractice(practiceIdx); });
    pracPrev.addEventListener('click', function() { if (practiceIdx > 0) playPractice(practiceIdx - 1); });
    pracNext.addEventListener('click', function() { if (practiceIdx < practicePairs.length - 1) playPractice(practiceIdx + 1); });
    pracToggle.addEventListener('click', function() {
      var open = pracExplanation.classList.toggle('open');
      pracToggle.innerHTML = open
        ? '<span class="i18n-en">Hide explanation</span><span class="i18n-zh">隐藏解释</span> &uarr;'
        : '<span class="i18n-en">Show explanation</span><span class="i18n-zh">显示解释</span> &darr;';
    });

    // ===== Language switch =====
    window.addEventListener('langchange', function() {
      if (practiceMode) showPractice(practiceIdx);
    }, sig);

    // ===== Arrived via auto-play =====
    // ===== Start in the listener's mode =====
    var startMode = arrivedJaOnly ? 'japanese' : null;
    if (!startMode) { try { startMode = localStorage.getItem('jdn-mode'); } catch(e) {} }
    if (startMode === 'japanese' && !isNihongo) {
      var modeBtn = document.querySelector('.mode-btn[data-mode="' + startMode + '"]');
      if (modeBtn) { restoringMode = true; modeBtn.click(); restoringMode = false; }
    }
    if ((arrivedAutoplay && autoplayOn) || arrivedPlay) {
      if (rangeOn()) seek(rStart);
      tryPlay();
    }

    // ===== Playlist (order + level are global preferences; auto-play follows them) =====
    var epNum = dataEl.getAttribute('data-num');
    var prevEpNum = dataEl.getAttribute('data-prev') || '';
    var isZhPage = langPrefix === '/zh';
    var plOrder = 'asc', plLevel = 'all';
    try {
      plOrder = localStorage.getItem('jdn-order') === 'desc' ? 'desc' : 'asc';
      var lvPref = localStorage.getItem('jdn-pl-level');
      plLevel = (!isNihongo && (lvPref === 'N5-N4' || lvPref === 'N4-N3')) ? lvPref : 'all';
    } catch(e) {}
    function loadList() {
      if (!epListP) epListP = fetch(channelPath + '/episodes.json').then(function(r) { return r.json(); })
        .then(function(l) { epList = l; return l; }).catch(function() { return null; });
      return epListP;
    }
    function orderedList() {
      var l = epList.filter(function(e) { return plLevel === 'all' || e.lv === plLevel; });
      return plOrder === 'desc' ? l.slice().reverse() : l;
    }
    // The episode auto-play goes to: the next one in the listener's order and
    // level; before the list has loaded, the neighbour in that direction.
    function nextEpisode() {
      if (epList) {
        var l = orderedList(), cur = Number(epNum);
        var i = l.findIndex(function(e) { return e.n === epNum; });
        if (i >= 0) return l[i + 1] ? l[i + 1].n : '';
        var after = l.filter(function(e) { return plOrder === 'asc' ? Number(e.n) > cur : Number(e.n) < cur; });
        return after.length ? after[0].n : '';
      }
      return plOrder === 'desc' ? prevEpNum : nextEpNum;
    }
    if (autoplayOn) loadList();   // ready by the end of the episode

    // ===== Changing episode in place =====
    // iOS won't start audio on a freshly loaded page without a tap, so moving on
    // by navigating left a silent page. Instead the next page is swapped in here
    // and keeps this <audio>, which the listener has already allowed to play.
    // It is fetched ahead (prepareNext): on a locked phone there may be no time
    // to wait for the network once the sound stops.
    var prepared = null;   // { n, doc }; doc stays null until fetched
    var leaving = false;
    function fetchEp(n) {
      return fetch(pagePrefix + '/ep/' + n + '/').then(function(r) {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.text();
      }).then(function(html) {
        var doc = new DOMParser().parseFromString(html, 'text/html');
        if (!doc.getElementById('seg-data')) throw new Error('not an episode page');
        return doc;
      });
    }
    function prepareNext() {
      var n = nextEpisode();
      prepared = { n: n, doc: null };
      if (n) fetchEp(n).then(function(doc) {
        if (prepared && prepared.n === n) prepared.doc = doc;
      }).catch(function() {});
    }
    function swapIn(n, doc, next) {
      reportListenTime();
      ctrl.abort();
      doc.querySelectorAll('.episode-body script').forEach(function(s) { s.remove(); });
      ['.ep-header', '.episode-body', '.player-inner', '#playlist', '#seg-data'].forEach(function(sel) {
        var cur = document.querySelector(sel);
        cur.parentNode.replaceChild(document.importNode(doc.querySelector(sel), true), cur);
      });
      tooltip.style.display = 'none';
      document.title = doc.title;
      ['data-alt-en', 'data-alt-zh'].forEach(function(a) {
        document.documentElement.setAttribute(a, doc.documentElement.getAttribute(a) || '');
      });
      var langLinks = doc.querySelectorAll('.lang-btn');
      document.querySelectorAll('.lang-btn').forEach(function(b, i) {
        if (langLinks[i]) b.setAttribute('href', langLinks[i].getAttribute('href'));
      });
      var canon = document.querySelector('link[rel="canonical"]');
      var newCanon = doc.querySelector('link[rel="canonical"]');
      if (canon && newCanon) canon.setAttribute('href', newCanon.getAttribute('href'));
      history.pushState(null, '', pagePrefix + '/ep/' + n + '/');
      window.scrollTo(0, 0);
      audio.src = '/audio/' + document.getElementById('seg-data').getAttribute('data-ep') + '.mp3';
      initEpisode(next);
    }
    function goToEpisode(n, next) {
      if (leaving) return;
      leaving = true;
      function navigate() {
        location.href = pagePrefix + '/ep/' + n + '/' +
          (next.play ? '?play=1' : '?autoplay=1' + (next.ja ? '&mode=ja' : ''));
      }
      if (!canSwap) { navigate(); return; }
      if (prepared && prepared.n === n && prepared.doc) { swapIn(n, prepared.doc, next); return; }
      audio.pause();
      fetchEp(n).then(function(doc) { swapIn(n, doc, next); }).catch(navigate);
    }

    var plPanel = document.getElementById('playlist');
    var plBtn = document.getElementById('playlistBtn');
    var plListEl = document.getElementById('plList');
    function syncSeg(id, attr, val) {
      document.querySelectorAll('#' + id + ' button').forEach(function(b) {
        var on = b.getAttribute(attr) === val;
        b.classList.toggle('active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });
    }
    function esc(t) { return String(t).replace(/[&<>"]/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    function renderList() {
      syncSeg('plOrder', 'data-order', plOrder);
      syncSeg('plLevel', 'data-level', plLevel);
      if (!epList) { plListEl.innerHTML = '<li class="pl-loading">…</li>'; return; }
      var prog = {};
      try { prog = JSON.parse(localStorage.getItem('jdn-progress') || '{}'); } catch(e) {}
      plListEl.innerHTML = orderedList().map(function(e) {
        var progKey = (isNihongo ? 'nh' : 'ep') + e.n;
        var cur = e.n === epNum, done = prog[progKey] && prog[progKey].listened;
        var tr = isZhPage ? e.zh : e.en;
        return '<li><a class="pl-item' + (cur ? ' current' : '') + '"' + (cur ? ' aria-current="true"' : '') +
          ' href="' + pagePrefix + '/ep/' + e.n + '/" data-n="' + e.n + '">' +
          '<span class="pl-num">' + e.n + '</span><span class="pl-text"><span class="pl-ja" lang="ja">' + esc(e.t) + '</span>' +
          (tr ? '<span class="pl-tr">' + esc(tr) + '</span>' : '') + '</span>' +
          '<span class="pl-meta">' + (done ? '<span class="pl-done" title="listened">&#10003;</span>' : '') + '<span class="pl-lv">' + esc(e.lv) + '</span></span></a></li>';
      }).join('');
      var c = plListEl.querySelector('.current');
      if (c) c.scrollIntoView({ block: 'center' });
    }
    function openList(open) {
      plPanel.hidden = !open;
      plBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
      plBtn.classList.toggle('active', open);
      if (open) { renderList(); loadList().then(renderList); ga('playlist_open'); }
    }
    plBtn.addEventListener('click', function() { openList(plPanel.hidden); });
    document.getElementById('plClose').addEventListener('click', function() { openList(false); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !plPanel.hidden) openList(false); }, sig);
    document.getElementById('plOrder').addEventListener('click', function(e) {
      var b = e.target.closest('button'); if (!b) return;
      plOrder = b.getAttribute('data-order');
      try { localStorage.setItem('jdn-order', plOrder); } catch(e2) {}
      ga('playlist_order', { order: plOrder });
      renderList();
    });
    document.getElementById('plLevel').addEventListener('click', function(e) {
      var b = e.target.closest('button'); if (!b) return;
      plLevel = b.getAttribute('data-level');
      try { localStorage.setItem('jdn-pl-level', plLevel); } catch(e2) {}
      ga('playlist_level', { level: plLevel });
      renderList();
    });
    // Picking an episode while listening keeps playing there.
    plListEl.addEventListener('click', function(e) {
      var a = e.target.closest('a.pl-item'); if (!a) return;
      ga('playlist_pick', { to: 'ep' + a.getAttribute('data-n') });
      if (!audio.paused) { e.preventDefault(); goToEpisode(a.getAttribute('data-n'), { play: true }); }
    });

    // ===== Chinese translation lines on/off (global preference) =====
    var trToggle = document.getElementById('tr-toggle');
    if (trToggle) {
      var syncTr = function() {
        var shown = !document.documentElement.classList.contains('hide-tr');
        trToggle.classList.toggle('on', shown);
        trToggle.setAttribute('aria-pressed', shown ? 'true' : 'false');
      };
      syncTr();
      trToggle.addEventListener('click', function() {
        var hide = document.documentElement.classList.toggle('hide-tr');
        try { localStorage.setItem('jdn-tr', hide ? '0' : '1'); } catch(e) {}
        syncTr();
        ga('translation_toggle', { shown: hide ? 0 : 1 });
      });
    }

    // ===== Review toggle =====
    var reviewToggle = document.getElementById('review-toggle');
    var reviewContent = document.getElementById('review-content');
    if (reviewToggle && reviewContent) {
      reviewToggle.addEventListener('click', function() {
        var open = reviewContent.style.display !== 'none';
        reviewContent.style.display = open ? 'none' : '';
        reviewToggle.classList.toggle('open', !open);
        // Open/closed is a reading preference: keep it for every episode.
        try { localStorage.setItem('jdn-review-open', open ? '0' : '1'); } catch(e) {}
        if (!open) ga('grammar_expand');
      });
      var reviewPref = null;
      try { reviewPref = localStorage.getItem('jdn-review-open'); } catch(e) {}
      if (reviewPref === '1' && reviewContent.style.display === 'none') {
        reviewContent.style.display = '';
        reviewToggle.classList.add('open');
      }
    }

    // ===== Episode nav (prev/next) =====
    document.addEventListener('click', function(e) {
      var nav = e.target.closest('.ep-nav-link, .ep-topnav-link');
      if (nav) {
        ga('episode_nav', { direction: nav.classList.contains('ep-nav-prev') ? 'prev' : 'next' });
      }
    }, sig);

    // ===== Keyboard =====
    document.addEventListener('keydown', function(e) {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      switch (e.code) {
        case 'Space':
          e.preventDefault();
    
          if (audio.paused) tryPlay(); else audio.pause();
          break;
        case 'ArrowLeft':
          e.preventDefault();
          seek(Math.max(0, pos() - 5));
          break;
        case 'ArrowRight':
          e.preventDefault();
          seek(Math.min(audio.duration || 0, pos() + 5));
          break;
        case 'ArrowUp':
          e.preventDefault();
          if (practiceMode) { if (practiceIdx > 0) { playPractice(practiceIdx - 1); } }
          else if (activeIndex > 0) { seek(segments[activeIndex - 1].start); tryPlay(); }
          break;
        case 'ArrowDown':
          e.preventDefault();
          if (practiceMode) { if (practiceIdx < practicePairs.length - 1) { playPractice(practiceIdx + 1); } }
          else if (activeIndex < segments.length - 1) { seek(segments[activeIndex + 1].start); tryPlay(); }
          break;
      }
    }, sig);
  }
  document.addEventListener('DOMContentLoaded', function() { initEpisode({}); });
  </script>
</Layout>
