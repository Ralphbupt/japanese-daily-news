---
import '../styles/global.css';
import { altPaths, HTML_LANG, HREFLANG, OG_LOCALE, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
  title?: string;
  /** Full <title> as is (no " — Japanese Daily News" appended). */
  fullTitle?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, any> | Record<string, any>[];
}

const SITE = 'https://podcast.jpnotes.dev';

const {
  lang = 'en',
  title = 'Japanese Daily News',
  description = 'Learn Japanese through real news stories. Daily podcast with vocabulary, grammar, and native audio.',
  ogImage = '/og.jpg', // 1200×630 for link previews; cover.jpg (3000×3000) stays the podcast artwork in the RSS feed
  jsonLd,
  fullTitle: fullTitleProp,
} = Astro.props;

const fullTitle = fullTitleProp || (title === 'Japanese Daily News' ? title : `${title} — Japanese Daily News`);
const ogUrl = new URL(Astro.url.pathname, SITE).href;
// The two language copies of this page (404 has none: it isn't per language).
const isPerLang = !Astro.url.pathname.startsWith('/404');
const alts = altPaths(Astro.url.pathname);
const ogImageUrl = new URL(ogImage, SITE).href;
---
<!DOCTYPE html>
<html lang={HTML_LANG[lang]} data-lang={lang} data-force-lang={isPerLang ? lang : undefined} data-alt-en={isPerLang ? alts.en : undefined} data-alt-zh={isPerLang ? alts.zh : undefined}>
<head>
  <script is:inline>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='warm'){document.documentElement.setAttribute('data-theme','warm')}
      else if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.setAttribute('data-theme','dark')}
      // One page per language (/ and /zh/). A reader whose language is the other
      // one goes there before anything paints: a saved choice (jdn-lang), or —
      // only on the English home page — a zh browser with none saved, so a /zh/
      // or /ep/ link someone shares always opens in its own language.
      var h=document.documentElement, page=h.getAttribute('data-force-lang');
      if(page){
        var saved=localStorage.getItem('jdn-lang');
        var want=saved||((page==='en'&&location.pathname==='/'&&/^zh/i.test(navigator.language||''))?'zh':page);
        var alt=want!==page&&h.getAttribute('data-alt-'+want);
        if(alt){location.replace(alt+location.search+location.hash);}
      } else {
        var sl=localStorage.getItem('jdn-lang');   // 404: one page, switched in place
        if(sl) h.setAttribute('data-lang',sl);
      }
      var fs=localStorage.getItem('jdn-fontsize')||'medium';
      document.documentElement.setAttribute('data-fontsize',fs);
      // Cache invalidation is now per-episode (see contentVersion in scripts/epNNN.json
      // and the restore guard in ep/[id].astro) — no global wipe, so changing one
      // episode no longer resets everyone's progress on the others.
    })();
  </script>
  <meta charset="UTF-8" />
  {/* Bing mostly ignores hreflang and goes by the declared language (jpnotes.dev learned
      this: Chinese queries landed on English pages) — so every page states it. */}
  <meta http-equiv="Content-Language" content={HTML_LANG[lang]} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="msvalidate.01" content="3D857E5EE3498FB5F8F63EEA5B69AFE1" />
  <meta name="theme-color" content="#f6f4ef" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#14141e" media="(prefers-color-scheme: dark)" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content="Japanese Daily News" />
  <meta property="og:locale" content={OG_LOCALE[lang]} />
  <meta property="og:locale:alternate" content={OG_LOCALE[lang === 'zh' ? 'en' : 'zh']} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="canonical" href={ogUrl} />
  {isPerLang && <link rel="alternate" hreflang={HREFLANG.en} href={new URL(alts.en, SITE).href} />}
  {isPerLang && <link rel="alternate" hreflang={HREFLANG.zh} href={new URL(alts.zh, SITE).href} />}
  {isPerLang && <link rel="alternate" hreflang="x-default" href={new URL(alts.en, SITE).href} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="alternate" type="application/rss+xml" title="Japanese Daily News" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="JDN Podcast" />
  <script is:inline>
  (function(){
    var ua=navigator.userAgent||'';
    var bot=navigator.webdriver||/HeadlessChrome|Lighthouse|PhantomJS|Puppeteer|Playwright|crawler|spider|bot|Slurp|facebookexternalhit/i.test(ua);
    if(bot){window.jdnEvent=function(){};return;}
    window.dataLayer=window.dataLayer||[];
    window.gtag=function(){dataLayer.push(arguments);};
    window.jdnEvent=function(n,p){try{window.gtag('event',n,p||{});}catch(e){}};
    gtag('js',new Date());
    // Defer GA entirely until the visitor shows a sign of being real:
    // first scroll, OR ~3s of actual *visible* time (background-tab time doesn't count).
    // A headless client that just loads the page and leaves never trips either, so it
    // never sends a page_view. Cost: page_view counts drop closer to real humans.
    var started=false;
    function startGA(){
      if(started)return;started=true;
      cleanup();
      gtag('config','G-7W59Y18KC8');
      var s=document.createElement('script');s.async=true;
      s.src='https://www.googletagmanager.com/gtag/js?id=G-7W59Y18KC8';
      document.head.appendChild(s);
    }
    var visTimer=null;
    function startTimer(){if(visTimer==null&&!document.hidden)visTimer=setTimeout(startGA,3000);}
    function stopTimer(){if(visTimer!=null){clearTimeout(visTimer);visTimer=null;}}
    function onVis(){if(document.hidden)stopTimer();else startTimer();}
    function cleanup(){
      stopTimer();
      window.removeEventListener('scroll',startGA);
      document.removeEventListener('visibilitychange',onVis);
    }
    window.addEventListener('scroll',startGA,{passive:true,once:true});
    document.addEventListener('visibilitychange',onVis);
    startTimer();
  })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;600&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script is:inline>
    var fst = document.getElementById('fontsize-toggle');
    if (fst) {
      var cfs = document.documentElement.getAttribute('data-fontsize') || 'medium';
      fst.querySelectorAll('.fontsize-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-size') === cfs); });
      fst.addEventListener('click', function(e) {
        var b = e.target.closest('.fontsize-btn');
        if (!b) return;
        var s = b.getAttribute('data-size');
        document.documentElement.setAttribute('data-fontsize', s);
        localStorage.setItem('jdn-fontsize', s);
        fst.querySelectorAll('.fontsize-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-size') === s); });
        if (window.jdnEvent) window.jdnEvent('fontsize_change', { size: s });
      });
    }
    var lt = document.getElementById('lang-toggle');
    if (lt) {
      var cl = document.documentElement.getAttribute('data-lang') || 'en';
      lt.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-lang') === cl); });
      lt.addEventListener('click', function(e) {
        var b = e.target.closest('.lang-btn');
        if (!b) return;
        var l = b.getAttribute('data-lang');
        localStorage.setItem('jdn-lang', l);
        if (window.jdnEvent) window.jdnEvent('language_toggle', { lang: l });
        var alt = document.documentElement.getAttribute('data-alt-' + l);
        if (alt) {
          // The buttons are links to the other copy (crawlable); keep the query.
          e.preventDefault();
          if (l !== cl) location.href = alt + location.search + location.hash;
        } else {
          // No copy in that language (404): switch in place.
          e.preventDefault();
          document.documentElement.setAttribute('data-lang', l);
          window.dispatchEvent(new Event('langchange'));
          lt.querySelectorAll('.lang-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-lang') === l); });
        }
      });
    }
    document.addEventListener('click', function(e) {
      if (!window.jdnEvent) return;
      var a = e.target.closest('a');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (href.indexOf('jpnotes.dev') >= 0 && href.indexOf('podcast.jpnotes.dev') < 0) {
        window.jdnEvent('cross_link_click', { destination: 'jpnotes.dev' }); return;
      }
      var blob = href + ' ' + (a.id || '');
      var isPlatform = a.classList.contains('platform-link') || /^footer-/.test(a.id || '') || href === '/rss.xml';
      if (isPlatform) {
        var name = /apple/i.test(blob) ? 'apple' :
                   /spotify/i.test(blob) ? 'spotify' :
                   /youtube/i.test(blob) ? 'youtube' :
                   href === '/rss.xml' ? 'rss' : 'other';
        window.jdnEvent('platform_click', { platform: name });
      }
    });

    // Themes cycle: light (jpnotes paper, default) → warm (the original yellow) → dark.
    document.getElementById('theme-toggle').addEventListener('click', function() {
      var order = ['light', 'warm', 'dark'];
      var cur = document.documentElement.getAttribute('data-theme') || 'light';
      var next = order[(order.indexOf(cur) + 1) % order.length];
      if (next === 'light') document.documentElement.removeAttribute('data-theme');
      else document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      if (window.jdnEvent) window.jdnEvent('theme_toggle', { theme: next });
    });
  </script>
</body>
</html>
