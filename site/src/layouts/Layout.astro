---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
}

const SITE = 'https://podcast.jpnotes.dev';

const {
  title = 'Japanese Daily News',
  description = 'Learn Japanese through real news stories. Daily podcast with vocabulary, grammar, and native audio.',
  ogImage = '/cover.jpg',
  jsonLd,
} = Astro.props;

const fullTitle = title === 'Japanese Daily News' ? title : `${title} — Japanese Daily News`;
const ogUrl = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.setAttribute('data-theme','dark')}
      var l=localStorage.getItem('jdn-lang')||((navigator.language||'').startsWith('zh')?'zh':'en');
      document.documentElement.setAttribute('data-lang',l);
      var fs=localStorage.getItem('jdn-fontsize')||'medium';
      document.documentElement.setAttribute('data-fontsize',fs);
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content="Japanese Daily News" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="canonical" href={ogUrl} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="alternate" type="application/rss+xml" title="Japanese Daily News" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-7W59Y18KC8" is:inline></script>
  <script is:inline>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-7W59Y18KC8');</script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=Shippori+Mincho:wght@400;600;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script is:inline>
    var fst = document.getElementById('fontsize-toggle');
    if (fst) {
      var cfs = document.documentElement.getAttribute('data-fontsize') || 'medium';
      fst.querySelectorAll('.fontsize-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-size') === cfs); });
      fst.addEventListener('click', function(e) {
        var b = e.target.closest('.fontsize-btn');
        if (!b) return;
        var s = b.getAttribute('data-size');
        document.documentElement.setAttribute('data-fontsize', s);
        localStorage.setItem('jdn-fontsize', s);
        fst.querySelectorAll('.fontsize-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-size') === s); });
      });
    }
    var lt = document.getElementById('lang-toggle');
    if (lt) {
      var cl = document.documentElement.getAttribute('data-lang') || 'en';
      lt.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-lang') === cl); });
      lt.addEventListener('click', function(e) {
        var b = e.target.closest('.lang-btn');
        if (!b) return;
        var l = b.getAttribute('data-lang');
        document.documentElement.setAttribute('data-lang', l);
        localStorage.setItem('jdn-lang', l);
        window.dispatchEvent(new Event('langchange'));
        lt.querySelectorAll('.lang-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-lang') === l); });
      });
    }
    document.getElementById('theme-toggle').addEventListener('click', function() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  </script>
</body>
</html>
