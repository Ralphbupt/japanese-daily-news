---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, any>;
}

const SITE = 'https://podcast.jpnotes.dev';

const {
  title = 'Japanese Daily News',
  description = 'Learn Japanese through real news stories. Daily podcast with vocabulary, grammar, and native audio.',
  ogImage = '/cover.jpg',
  jsonLd,
} = Astro.props;

const fullTitle = title === 'Japanese Daily News' ? title : `${title} — Japanese Daily News`;
const ogUrl = new URL(Astro.url.pathname, SITE).href;
const ogImageUrl = new URL(ogImage, SITE).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <script is:inline>
    (function(){
      var t=localStorage.getItem('theme');
      if(t==='dark'||(!t&&window.matchMedia('(prefers-color-scheme:dark)').matches)){document.documentElement.setAttribute('data-theme','dark')}
      var l=localStorage.getItem('jdn-lang')||((navigator.language||'').startsWith('zh')?'zh':'en');
      document.documentElement.setAttribute('data-lang',l);
      var fs=localStorage.getItem('jdn-fontsize')||'medium';
      document.documentElement.setAttribute('data-fontsize',fs);
      var PAGE_VERSION='2026060501';
      var storedVersion=localStorage.getItem('jdn-version');
      if(storedVersion!==PAGE_VERSION){localStorage.removeItem('jdn-ep001');localStorage.removeItem('jdn-ep002');localStorage.removeItem('jdn-ep003');localStorage.removeItem('jdn-ep004');var keys=Object.keys(localStorage);for(var i=0;i<keys.length;i++){if(keys[i].startsWith('jdn-ep'))localStorage.removeItem(keys[i]);}localStorage.setItem('jdn-version',PAGE_VERSION);}
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#F3EDDA" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#1A1A1E" media="(prefers-color-scheme: dark)" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:url" content={ogUrl} />
  <meta property="og:site_name" content="Japanese Daily News" />
  <meta property="og:locale" content="ja_JP" />
  <meta property="og:locale:alternate" content="zh_CN" />
  <meta property="og:locale:alternate" content="en_US" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <link rel="canonical" href={ogUrl} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <link rel="alternate" type="application/rss+xml" title="Japanese Daily News" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="JDN Podcast" />
  <script is:inline>
  (function(){
    var ua=navigator.userAgent||'';
    var bot=navigator.webdriver||/HeadlessChrome|Lighthouse|PhantomJS|Puppeteer|Playwright|crawler|spider|bot|Slurp|facebookexternalhit/i.test(ua);
    if(bot){window.jdnEvent=function(){};return;}
    window.dataLayer=window.dataLayer||[];
    window.gtag=function(){dataLayer.push(arguments);};
    window.jdnEvent=function(n,p){try{window.gtag('event',n,p||{});}catch(e){}};
    gtag('js',new Date());
    // Defer GA entirely until the visitor shows a sign of being real:
    // first scroll, OR ~3s of actual *visible* time (background-tab time doesn't count).
    // A headless client that just loads the page and leaves never trips either, so it
    // never sends a page_view. Cost: page_view counts drop closer to real humans.
    var started=false;
    function startGA(){
      if(started)return;started=true;
      cleanup();
      gtag('config','G-7W59Y18KC8');
      var s=document.createElement('script');s.async=true;
      s.src='https://www.googletagmanager.com/gtag/js?id=G-7W59Y18KC8';
      document.head.appendChild(s);
    }
    var visTimer=null;
    function startTimer(){if(visTimer==null&&!document.hidden)visTimer=setTimeout(startGA,3000);}
    function stopTimer(){if(visTimer!=null){clearTimeout(visTimer);visTimer=null;}}
    function onVis(){if(document.hidden)stopTimer();else startTimer();}
    function cleanup(){
      stopTimer();
      window.removeEventListener('scroll',startGA);
      document.removeEventListener('visibilitychange',onVis);
    }
    window.addEventListener('scroll',startGA,{passive:true,once:true});
    document.addEventListener('visibilitychange',onVis);
    startTimer();
  })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;1,9..144,400&family=Noto+Sans+JP:wght@400;500;700&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <slot />
  <script is:inline>
    var fst = document.getElementById('fontsize-toggle');
    if (fst) {
      var cfs = document.documentElement.getAttribute('data-fontsize') || 'medium';
      fst.querySelectorAll('.fontsize-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-size') === cfs); });
      fst.addEventListener('click', function(e) {
        var b = e.target.closest('.fontsize-btn');
        if (!b) return;
        var s = b.getAttribute('data-size');
        document.documentElement.setAttribute('data-fontsize', s);
        localStorage.setItem('jdn-fontsize', s);
        fst.querySelectorAll('.fontsize-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-size') === s); });
        if (window.jdnEvent) window.jdnEvent('fontsize_change', { size: s });
      });
    }
    var lt = document.getElementById('lang-toggle');
    if (lt) {
      var cl = document.documentElement.getAttribute('data-lang') || 'en';
      lt.querySelectorAll('.lang-btn').forEach(function(b) { b.classList.toggle('active', b.getAttribute('data-lang') === cl); });
      lt.addEventListener('click', function(e) {
        var b = e.target.closest('.lang-btn');
        if (!b) return;
        var l = b.getAttribute('data-lang');
        document.documentElement.setAttribute('data-lang', l);
        localStorage.setItem('jdn-lang', l);
        window.dispatchEvent(new Event('langchange'));
        lt.querySelectorAll('.lang-btn').forEach(function(x) { x.classList.toggle('active', x.getAttribute('data-lang') === l); });
        if (window.jdnEvent) window.jdnEvent('language_toggle', { lang: l });
      });
    }
    document.addEventListener('click', function(e) {
      if (!window.jdnEvent) return;
      var a = e.target.closest('a');
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (href.indexOf('jpnotes.dev') >= 0 && href.indexOf('podcast.jpnotes.dev') < 0) {
        window.jdnEvent('cross_link_click', { destination: 'jpnotes.dev' }); return;
      }
      var blob = href + ' ' + (a.id || '');
      var isPlatform = a.classList.contains('platform-link') || /^footer-/.test(a.id || '') || href === '/rss.xml';
      if (isPlatform) {
        var name = /apple/i.test(blob) ? 'apple' :
                   /spotify/i.test(blob) ? 'spotify' :
                   /youtube/i.test(blob) ? 'youtube' :
                   href === '/rss.xml' ? 'rss' : 'other';
        window.jdnEvent('platform_click', { platform: name });
      }
    });

    document.getElementById('theme-toggle').addEventListener('click', function() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('theme', 'light');
        if (window.jdnEvent) window.jdnEvent('theme_toggle', { theme: 'light' });
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('theme', 'dark');
        if (window.jdnEvent) window.jdnEvent('theme_toggle', { theme: 'dark' });
      }
    });
  </script>
</body>
</html>
