#!/bin/sh
# Validate staged episode JSON files before commit.
# Enable with: git config core.hooksPath .githooks

python3 "$(git rev-parse --show-toplevel)/tools/validate-episode.py" --staged
status=$?

if [ $status -ne 0 ]; then
  echo ""
  echo "Episode JSON validation failed. Fix the errors above or commit with --no-verify to bypass." >&2
fi

exit $status
